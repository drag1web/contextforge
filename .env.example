# ContextForge desktop defaults to local SQLite.
STORAGE_DRIVER=sqlite
SQLITE_DB_PATH=./data/contextforge.sqlite

# Use PostgreSQL only for cloud/dev experiments:
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgresql://contextforge:contextforge@127.0.0.1:5433/contextforge

SERVER_PORT=4000
OLLAMA_URL=http://localhost:11434
APP_VERSION=0.6.7-alpha

# Optional website connection for account pairing, device presence, and releases.
# Production builds require HTTPS. Local HTTP is accepted only in development.
CONTEXTFORGE_WEB_ORIGIN=https://contextforge.dev

# GitHub integration (optional). Local-first mode works without this.
GITHUB_OAUTH_CLIENT_ID=Ov23li86sPIU59fQzqqn
GITHUB_OAUTH_SCOPES=read:user repo
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
