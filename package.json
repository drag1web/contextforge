{
  "name": "contextforge",
  "version": "0.6.7-alpha",
  "private": true,
  "description": "Desktop AI devtool for preparing software projects for AI agents.",
  "type": "module",
  "workspaces": [
    "apps/desktop/renderer",
    "server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,RENDERER,ELECTRON -c blue,green,magenta \"npm run dev:server\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:server": "npm run dev -w @contextforge/server",
    "dev:renderer": "npm run dev -w @contextforge/renderer",
    "dev:electron": "wait-on tcp:5173 tcp:4000 && cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron apps/desktop/electron/main.cjs",
    "build": "npm run build -w @contextforge/renderer && npm run build -w @contextforge/server",
    "test:selector": "npm run test:selector -w @contextforge/server",
    "test:selector:rollout": "npm run test:selector:rollout -w @contextforge/server",
    "test:selector:rollout-ui": "npm exec -w @contextforge/server -- tsx ../scripts/pipelineBadge.smoke.ts",
    "benchmark:selector": "npm run benchmark:selector -w @contextforge/server",
    "benchmark:selector:validation": "npm run benchmark:selector:validation -w @contextforge/server",
    "benchmark:selector:snapshot": "npm run benchmark:selector:snapshot -w @contextforge/server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "test:generation:taskpack": "npm run test:generation:taskpack -w @contextforge/server",
    "test:understanding": "npm run test:understanding -w @contextforge/server",
    "test:clarification": "npm run test:clarification -w @contextforge/server",
    "test:performance": "npm run test:performance -w @contextforge/server",
    "test:handoff": "npm run test:handoff -w @contextforge/server",
    "test:investigation": "npm run test:investigation -w @contextforge/server",
    "test:ownership": "npm run test:ownership -w @contextforge/server",
    "test:validation-lab": "node --import tsx scripts/validationLab.smoke.ts",
    "test:canonical-core": "npm run test:canonical-core -w @contextforge/server",
    "test:context-quality": "npm run test:context-quality -w @contextforge/server",
    "test:symbol-syntax": "npm run test:symbol-syntax -w @contextforge/server",
    "test:support-grounding": "npm run test:support-grounding -w @contextforge/server",
    "test:authorization-authority": "npm run test:authorization-authority -w @contextforge/server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  }
}
